{
  "name": "mathbox-next",
  "version": "0.1.1",
  "description": "Lightweight TypeScript math visualization library built on three.js r185",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepublishOnly": "yarn run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mathbox",
    "three.js",
    "webgl",
    "3d",
    "math",
    "visualization",
    "plotting"
  ],
  "author": "yuqiang-yuan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuqiang-yuan/mathbox-next.git"
  },
  "homepage": "https://github.com/yuqiang-yuan/mathbox-next#readme",
  "bugs": {
    "url": "https://github.com/yuqiang-yuan/mathbox-next/issues"
  },
  "dependencies": {
    "mathjs": "^15.2.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  }
}
